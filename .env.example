DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
CONTAINER_NAME=

# Порты на хосте для docker compose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- MinIO (S3-совместимое хранилище фото) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mgts-objects
S3_REGION=us-east-1
# Локальный запуск backend без Docker. В docker-compose переопределяется на http://minio:9000.
S3_ENDPOINT=http://localhost:9000

# --- ИИ-воркер (обработка фото через YOLO из папки cv) ---
# Пусто = cv/ml/yolo-v/2-version.pt в корне проекта. В Docker монтируется /weights/2-version.pt.
WEIGHTS_PATH=
CV_MIN_CONFIDENCE=0.4
CV_HIGH_CONFIDENCE=0.75
CV_IOU=0.5
CV_IMGSZ=640
WORKER_POLL_INTERVAL=3
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_MINUTES=5
# Общий каталог загруженных и обработанных файлов. Пусто = <корень>/uploads,
# в Docker задаётся как /app/uploads.
UPLOADS_DIR=
MAX_UPLOAD_MB=10
